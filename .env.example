# Copy this to .env and fill in your values. Never commit .env.

# Kalshi — get from kalshi.com > Account > API Settings
# Generate the RSA key pair there; paste the full private key below.
# In .env, replace actual newlines with \n so it fits on one line.
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----

# NewsAPI — newsapi.org (free tier: 100 req/day)
NEWSAPI_KEY=your_key_here

# Alpha Vantage — alphavantage.co (free tier: 25 req/day)
ALPHAVANTAGE_KEY=your_key_here

# Polymarket: no API key needed for public market data
